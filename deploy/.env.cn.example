# Aero 国内环境部署默认配置
# 用法: docker compose --env-file .env.cn -f docker-compose.yml -f docker-compose.cn.yml up --build

# ===== 基础配置 =====
AERO_ENV=prod
AERO_HTTP_PORT=80

# ===== 数据库（生产请改为强密码）=====
AERO_PG_USER=aero
AERO_PG_PASSWORD=change-me
AERO_PG_DB=aero

# ===== 镜像源（构建时使用）=====
# uv 镜像（DockerHub）。如需进一步加速可换成阿里云/腾讯云镜像加速地址
UV_IMAGE=astral/uv:latest
# PyPI 镜像（清华）
UV_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# npm 镜像（淘宝）
NPM_REGISTRY=https://registry.npmmirror.com
